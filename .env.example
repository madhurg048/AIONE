# =============================================================================
# PayG CRM — environment template
# =============================================================================
# THIS FILE IS COMMITTED. It must never contain a real secret.
#
# Local / VM:  cp .env.example .env  and fill in the real values.
# Azure:       do NOT ship a .env. Put each key below into
#              App Service → Settings → Environment variables → App settings.
#              Real environment variables always beat the .env file.
# =============================================================================

# ---- App ---------------------------------------------------------------
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Asia/Kolkata
# Leave unset to derive from APP_TIMEZONE. Format: +05:30
#APP_TIMEZONE_OFFSET=

# Sample login buttons (admin/admin123 etc.) on the login page.
# MUST stay false in production. Set to true only on a local dev machine.
PAYG_ENABLE_SAMPLE_LOGIN=false

# ---- Database ----------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=super_payg_crm
DB_USER=
DB_PASS=
DB_TIMEOUT=10

# TLS. Plain MySQL VM -> false. Azure MySQL Flexible Server -> true (required).
DB_SSL=false
# Absolute path to the CA bundle. For Azure MySQL download DigiCertGlobalRootCA.crt.pem
# and point at it, e.g. /home/site/wwwroot/certs/DigiCertGlobalRootCA.crt.pem
DB_SSL_CA=
DB_SSL_VERIFY=true

# ---- File storage ------------------------------------------------------
# Where api/sales/documents.php stores uploaded KYC/merchant documents.
# These are ONLY served back through the login-gated proxy, so the path does
# not need to be inside the web root.
# Azure App Service: set this to /home/data/documents — /home is the only
# persistent writable mount, and wwwroot is read-only under RUN_FROM_PACKAGE.
# Leave empty to use the in-repo default (data/documents).
DOC_STORAGE_PATH=

# ---- AI (optional) -----------------------------------------------------
# The primary AI box + cloud fallback are configured in the UI
# (Settings -> AI Engine) and stored in the ai_settings table.
# These are only the last-resort fallback used when both are unreachable.
# Leave empty to disable the fallback — pages degrade to evidence-only mode.
SERVICE_BASE_URL=
SERVICE_CHAT_ENDPOINT=
SERVICE_CHAT_KEY=

# ai-bridge.php (OpenAI-compatible adapter). Empty = disabled.
LLM_URL=
LLM_KEY=

# ---- Scheduled jobs (cron) ---------------------------------------------
# Azure App Service (Linux) has NO cron daemon. The sweeps in cron/ must be
# triggered by an external scheduler over HTTPS, e.g.
#   https://aione.payg.in/cron/run-sales-automations.php?token=<CRON_TOKEN>
# Without a token set, those URLs return 404 (fails closed).
# Generate one with:  php -r "echo bin2hex(random_bytes(24));"
# Not needed if you run the sweeps from a real crontab via PHP CLI.
CRON_TOKEN=

# ---- OTP / verification (chatbot + CRM password reset) -----------------
# PayG's own verification service (production).
# Endpoints used: Send_MobileOTP / Verify_MobileOTP / Send_EmailOTP / Verify_EmailOTP
PAYG_OTP_BASE=https://apiv3.PayG.in/virtualPOS/api/WebSite/

# TLS certificate verification for the OTP calls. Leave false.
# true disables verification — the OTP and verification id would be exposed to
# anything on the network path. Only for a genuine local CA problem.
OTP_TLS_INSECURE=false

# Offline dev fallback that accepts OTP 123456.
# *** MUST STAY false ON ANY PUBLIC HOST. ***
# When true AND the verification service is unreachable, ANY 6-digit code
# verifies — that is an account takeover via forgot-password.php.
OTP_DEV_FALLBACK=false

# ---- Exotel (standalone call.php test harness) -------------------------
# The CRM's real click-to-call uses Settings -> Telephony (telephony_settings
# table), not these. Leave empty if you don't use call.php.
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_API_BASE_URL=https://api.exotel.com
EXOTEL_CALLER_ID=
EXOTEL_AGENT_NUMBER=
EXOTEL_HTTP_TIMEOUT=30
# On Azure Linux only /home is persistent and writable.
EXOTEL_LOG_FILE=/home/LogFiles/exotel.log

# ---- PayG Merchant Onboarding API (external PIMS) ----------------------
PAYG_MERCHANT_API_URL=https://devapi.payg.in/merchant/api/Merchantlevel/MerchantOnboarding
PAYG_TOKEN_API_URL=https://devapi.payg.in/merchant/api/Merchantlevel/GetAuthToken
PAYG_CLIENT_ID=
PAYG_CLIENT_SECRET=
PAYG_CLIENT_SCOPE=CRM:MerchantCreation

# ---- WhatsApp Business API ---------------------------------------------
# Can also be set in the UI (Settings -> WhatsApp). Credentials pending from client.
WHATSAPP_ENABLED=false
WHATSAPP_ENV=test
WHATSAPP_PROVIDER=
WHATSAPP_TEST_BASE_URL=
WHATSAPP_TEST_API_KEY=
WHATSAPP_TEST_PHONE_NUMBER=
WHATSAPP_TEST_PHONE_ID=
WHATSAPP_TEST_BUSINESS_ID=
WHATSAPP_PROD_BASE_URL=
WHATSAPP_PROD_API_KEY=
WHATSAPP_PROD_PHONE_NUMBER=
WHATSAPP_PROD_PHONE_ID=
WHATSAPP_PROD_BUSINESS_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_MESSAGING_WINDOW_HOURS=24
WHATSAPP_DEFAULT_LANGUAGE=en
