# =====================================================================
# PayG CRM — environment configuration
# ---------------------------------------------------------------------
# Copy to `.env` in the same folder as index.php, or (preferred on Azure)
# add each KEY as an Application Setting under:
#   App Service -> Settings -> Environment variables -> App settings
#
# Real environment variables always win over this file.
# NEVER commit the filled-in `.env` — it is gitignored.
# =====================================================================

# --- Database (REQUIRED — the app will not start without these) ------
DB_HOST=
DB_NAME=super_payg
DB_USER=
DB_PASS=

# --- Timezone (optional; defaults shown) -----------------------------
APP_TIMEZONE=Asia/Kolkata
APP_TIMEZONE_OFFSET=+05:30

# --- AI (optional) ---------------------------------------------------
# Last-resort fallback endpoint + its bearer key. The PRIMARY AI path is the
# AI box configured in the UI under Settings -> AI Engine (box URL + AI API
# key are stored in the `ai_settings` table, not here).
#
# NOTE: this key was previously shared with the retired voice service. Issue a
# NEW key — do not reuse the old gck_... value, which has been leaked.
SERVICE_BASE_URL=https://167.235.90.27
SERVICE_CHAT_ENDPOINT=
SERVICE_CHAT_KEY=

# ai-bridge.php only (OpenAI-compatible adapter). Falls back to
# SERVICE_CHAT_KEY when unset.
LLM_URL=
LLM_KEY=

# --- Sample logins ---------------------------------------------------
# MUST stay false/unset in production. Setting this to true re-enables the
# admin/admin123 style demo accounts and the click-to-login buttons.
PAYG_ENABLE_SAMPLE_LOGIN=false
