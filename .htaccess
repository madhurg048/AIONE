Options -Indexes
DirectoryIndex index.php

<IfModule mod_env.c>
    # Sample-login boxes on the login page (admin/admin123 etc). Must stay "false"
    # in production. config/app.php defaults this ON, so removing this line is not
    # enough to disable it — the value has to be set to false explicitly.
    SetEnv PAYG_ENABLE_SAMPLE_LOGIN false
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteRule ^$ index.php [L]

    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^([A-Za-z0-9_-]+)/?$ $1.php [L]
</IfModule>

<FilesMatch "(?i)\.(sql|md|zip)$">
    Require all denied
</FilesMatch>

<FilesMatch "(?i)^\.">
    Require all denied
</FilesMatch>

# One-shot installers, demo seeders, password resets and the data-wipe/cutover
# scripts. None of them authenticate — production-wipe-keep-admin.php?confirm=yes
# truncates leads/deals/merchants/tickets/chats/calls/timesheets to anyone who
# asks. Blocked over HTTP; still runnable from the CLI (php <file> confirm).
# Belt and braces only: these files should not be uploaded to production at all.
<FilesMatch "(?i)^(create-users|create-dept-managers|create-service-users|create-service-sample-data|seed-chat|setup|sales-setup|reset-dev-passwords|production-cutover|production-wipe-keep-admin)\.php$">
    Require all denied
</FilesMatch>
