# =============================================================================
# Line endings
# =============================================================================
# This repo is authored on Windows but deployed to Linux (Azure App Service /
# Ubuntu). Anything the Linux shell or Nginx has to parse MUST be checked out
# with LF endings — a CRLF shebang makes bash fail with
# "bad interpreter: /bin/bash^M" and the container never starts.

* text=auto eol=lf

*.sh        text eol=lf
*.conf      text eol=lf
.env*       text eol=lf
.htaccess   text eol=lf
*.php       text eol=lf
*.js        text eol=lf
*.css       text eol=lf
*.html      text eol=lf
*.sql       text eol=lf
*.md        text eol=lf

# Windows-side files that should keep CRLF
*.bat       text eol=crlf
*.cmd       text eol=crlf
web.config  text eol=crlf

# Never touch binaries
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.svg       text eol=lf
*.woff      binary
*.woff2     binary
*.ttf       binary
*.docx      binary
*.xlsx      binary
*.zip       binary
*.pdf       binary
