<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS config — only used if this app runs on Azure App Service for WINDOWS.
  On Azure App Service for LINUX (Nginx) this file is ignored; the equivalent
  rules live in deploy/nginx-default.conf, installed by deploy/startup.sh.
  On the Ubuntu/Apache VM, .htaccess is what applies.

  Harmless to leave in place on any of the three.
-->
<configuration>
  <system.webServer>

    <defaultDocument>
      <files>
        <clear />
        <add value="index.php" />
      </files>
    </defaultDocument>

    <directoryBrowse enabled="false" />

    <security>
      <requestFiltering>
        <!-- Never serve secrets, dumps or credential documents. -->
        <fileExtensions>
          <add fileExtension=".env" allowed="false" />
          <add fileExtension=".sql" allowed="false" />
          <add fileExtension=".md" allowed="false" />
          <add fileExtension=".xlsx" allowed="false" />
          <add fileExtension=".xls" allowed="false" />
          <add fileExtension=".docx" allowed="false" />
          <add fileExtension=".log" allowed="false" />
          <add fileExtension=".pem" allowed="false" />
          <add fileExtension=".key" allowed="false" />
        </fileExtensions>
        <hiddenSegments>
          <add segment="database" />
          <add segment="scripts" />
          <add segment="cron" />
          <add segment="deploy" />
          <add segment=".git" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <rewrite>
      <rules>
        <!-- Unauthenticated installers / seeders / data-wipe scripts. -->
        <rule name="BlockDangerousScripts" stopProcessing="true">
          <match url="^(setup|sales-setup|create-users|create-dept-managers|create-service-users|create-service-sample-data|seed-chat|seed-legal|reset-dev-passwords|production-cutover|production-wipe-keep-admin|simulate-incoming-call)\.php$" ignoreCase="true" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
        </rule>

        <!-- Uploaded KYC docs go through the login-gated proxy only. -->
        <rule name="BlockDocuments" stopProcessing="true">
          <match url="^data/documents/" ignoreCase="true" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
        </rule>

        <!-- Extensionless URLs: /sales-leads -> /sales-leads.php -->
        <rule name="ExtensionlessPhp" stopProcessing="true">
          <match url="^([A-Za-z0-9_-]+)/?$" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{APPL_PHYSICAL_PATH}{R:1}.php" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="{R:1}.php" />
        </rule>
      </rules>
    </rewrite>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <!--
          DO NOT add a global X-Frame-Options/DENY here. /chat.php is loaded in a
          cross-origin <iframe> by the chat widget on payg.in; a blanket
          X-Frame-Options would make the chatbot render as a blank box and no
          ticket would ever reach the Sales/Service teams.
          IIS has no per-path header scoping in this file, so framing is left
          open here — the Linux/Nginx config (deploy/nginx-default.conf) does it
          properly with CSP frame-ancestors.
        -->
      </customHeaders>
    </httpProtocol>

  </system.webServer>
</configuration>
